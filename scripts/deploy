#!/usr/bin/env bash
set -euo pipefail

readonly WORKFLOW="application-deploy.yml"
readonly RESOURCE_GROUP="research-analysis-dev-rg"
readonly CONTAINER_APP="research-analysis-dev"
readonly REGISTRY_NAME="researchanalysisdev39fbe143"
readonly REGISTRY_SERVER="researchanalysisdev39fbe143.azurecr.io"
readonly IMAGE_REPOSITORY="research-analysis"

usage() {
  printf '%s\n' "Usage:" "  deploy dev" "  deploy history dev" \
    "  deploy rollback dev [commit]" >&2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Required command not found: $1" >&2
    exit 1
  }
}

current_image() {
  az containerapp show --name "${CONTAINER_APP}" \
    --resource-group "${RESOURCE_GROUP}" \
    --query 'properties.template.containers[0].image' --output tsv
}

application_url() {
  local fqdn
  fqdn="$(az containerapp show --name "${CONTAINER_APP}" \
    --resource-group "${RESOURCE_GROUP}" \
    --query 'properties.configuration.ingress.fqdn' --output tsv)"
  printf 'https://%s\n' "${fqdn}"
}

verify_application() {
  local expected_image="$1" url="$2" status
  for attempt in {1..24}; do
    status="$(az containerapp revision list --name "${CONTAINER_APP}" \
      --resource-group "${RESOURCE_GROUP}" \
      --query "[?properties.active && properties.template.containers[0].image=='${expected_image}'] | [0].{health:properties.healthState,state:properties.provisioningState}" \
      --output tsv)"
    if [[ "${status}" == *Healthy* && "${status}" == *Provisioned* ]] && \
      curl --fail --silent --show-error --max-time 30 "${url}/health" | grep -q '"healthy"' && \
      curl --fail --silent --show-error --max-time 30 --request POST \
        --header 'Content-Type: application/json' \
        --data '{"ticker":"ROLLBACK","prices":[100,101,102]}' \
        "${url}/analysis" | grep -q '"ticker":"ROLLBACK"'; then
      return 0
    fi
    echo "Verification ${attempt}/24 has not passed; retrying in 10 seconds."
    sleep 10
  done
  return 1
}

deploy_dev() {
  require_command gh
  require_command git
  local branch local_commit remote_commit short_commit successful_run run_id

  branch="$(git branch --show-current)"
  [[ "${branch}" == main ]] || {
    echo "DEV deployments must start from main; current branch is '${branch}'." >&2
    exit 1
  }
  [[ -z "$(git status --porcelain)" ]] || {
    echo "Working tree is not clean. Commit or discard local changes first." >&2
    exit 1
  }

  echo "Checking origin/main..."
  git fetch --quiet origin main
  local_commit="$(git rev-parse HEAD)"
  remote_commit="$(git rev-parse origin/main)"
  short_commit="$(git rev-parse --short=8 HEAD)"
  [[ "${local_commit}" == "${remote_commit}" ]] || {
    echo "Local main is not synchronized with origin/main." >&2
    exit 1
  }

  successful_run="$(gh run list --workflow "${WORKFLOW}" \
    --commit "${local_commit}" --status success --limit 1 \
    --json databaseId --jq '.[0].databaseId // empty')"
  if [[ -n "${successful_run}" ]]; then
    echo "No updates to deploy; commit ${short_commit} is already deployed to DEV."
    return
  fi

  echo "Requesting DEV deployment for commit ${short_commit}..."
  gh workflow run "${WORKFLOW}" --ref main
  run_id=""
  for _ in {1..15}; do
    run_id="$(gh run list --workflow "${WORKFLOW}" --commit "${local_commit}" \
      --event workflow_dispatch --limit 1 --json databaseId \
      --jq '.[0].databaseId // empty')"
    [[ -z "${run_id}" ]] || break
    sleep 2
  done
  [[ -n "${run_id}" ]] || {
    echo "Deployment was requested, but its run could not be found." >&2
    exit 1
  }
  echo "Watching GitHub Actions run ${run_id}..."
  gh run watch "${run_id}" --exit-status
  echo "DEV deployment completed for commit ${short_commit}."
}

history_dev() {
  require_command az
  require_command gh
  echo "Running DEV image: $(current_image)"
  echo
  echo "Recent immutable images:"
  az acr repository show-tags --name "${REGISTRY_NAME}" \
    --repository "${IMAGE_REPOSITORY}" --detail --orderby time_desc \
    --query "[?name!='dev'].{commit:name,created:createdTime,digest:digest}" \
    --output table
  echo
  echo "Recent successful deployments:"
  gh run list --workflow "${WORKFLOW}" --status success --limit 10 \
    --json headSha,createdAt,url \
    --template '{{tablerow "COMMIT" "CREATED" "RUN"}}{{range .}}{{tablerow (slice .headSha 0 8) .createdAt .url}}{{end}}'
}

previous_image_tag() {
  local running_tag="$1" found=false tag
  while IFS= read -r tag; do
    if [[ "${found}" == true ]]; then
      printf '%s\n' "${tag}"
      return
    fi
    [[ "${tag}" != "${running_tag}" ]] || found=true
  done < <(az acr repository show-tags --name "${REGISTRY_NAME}" \
    --repository "${IMAGE_REPOSITORY}" --detail --orderby time_desc \
    --query "[?name!='dev'].name" --output tsv)
  return 1
}

rollback_dev() {
  require_command az
  require_command curl
  local requested="${1:-}" starting_image starting_tag target_tag target_image url
  starting_image="$(current_image)"
  starting_tag="${starting_image##*:}"

  if [[ -n "${requested}" ]]; then
    target_tag="${requested:0:8}"
    [[ "${target_tag}" =~ ^[0-9a-f]{8}$ ]] || {
      echo "Rollback commit must contain at least eight hexadecimal characters." >&2
      exit 2
    }
  else
    target_tag="$(previous_image_tag "${starting_tag}")" || {
      echo "No older immutable image is available before ${starting_tag}." >&2
      exit 1
    }
  fi

  if [[ "${target_tag}" == "${starting_tag}" ]]; then
    echo "DEV is already running commit ${target_tag}; no rollback is needed."
    return
  fi
  az acr repository show --name "${REGISTRY_NAME}" \
    --image "${IMAGE_REPOSITORY}:${target_tag}" --output none 2>/dev/null || {
    echo "Image ${IMAGE_REPOSITORY}:${target_tag} does not exist in ACR." >&2
    exit 1
  }

  target_image="${REGISTRY_SERVER}/${IMAGE_REPOSITORY}:${target_tag}"
  url="$(application_url)"
  echo "Rolling DEV back from ${starting_tag} to ${target_tag}..."
  az containerapp update --name "${CONTAINER_APP}" \
    --resource-group "${RESOURCE_GROUP}" --image "${target_image}" --output none
  if verify_application "${target_image}" "${url}"; then
    echo "Rollback completed: ${starting_tag} -> ${target_tag}"
    echo "Application: ${url}"
    return
  fi

  echo "Rollback verification failed; restoring ${starting_tag}..." >&2
  az containerapp update --name "${CONTAINER_APP}" \
    --resource-group "${RESOURCE_GROUP}" --image "${starting_image}" --output none
  if verify_application "${starting_image}" "${url}"; then
    echo "Original DEV image ${starting_tag} was restored." >&2
  else
    echo "CRITICAL: automatic restoration could not be verified." >&2
  fi
  exit 1
}

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Run this command inside the repository." >&2
  exit 1
}
cd "${REPO_ROOT}"

case "${1:-}" in
  dev) [[ $# -eq 1 ]] || { usage; exit 2; }; deploy_dev ;;
  history) [[ $# -eq 2 && "${2:-}" == dev ]] || { usage; exit 2; }; history_dev ;;
  rollback) [[ $# -ge 2 && $# -le 3 && "${2:-}" == dev ]] || { usage; exit 2; }; rollback_dev "${3:-}" ;;
  *) usage; exit 2 ;;
esac
